# Static frontend (D-003). Runtime config is written to /srv/js/config.js by docker-entrypoint.sh.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	try_files {path} {path}.html
	file_server

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' {$API_BASE_URL} {$SUPABASE_URL}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Railway always terminates TLS in front of this service
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# no build step = no fingerprinted file names: revalidate code on every load so a deploy never mixes versions
	@code path / *.html /js/* /css/*
	header @code Cache-Control "no-cache"
	header /js/config.js Cache-Control "no-store"
	header /fonts/* Cache-Control "public, max-age=31536000, immutable"
}
