# --- Backend environment (example; never commit real values) ---
APP_ENV=dev                      # dev | production
PORT=8000                        # Railway injects PORT
SUPABASE_URL=https://<project-ref>.supabase.co          # public
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...            # public
SUPABASE_SECRET_KEY=sb_secret_...                      # SECRET (service role equivalent) - server only
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
FRONTEND_ORIGIN=https://<frontend-domain>              # public
CORS_ALLOWED_ORIGINS=https://<frontend-domain>         # comma-separated exact origins
AI_PROVIDER=openai                # openai | none
AI_MODEL=                        # e.g. an OpenAI model id; leave empty until decided
AI_API_KEY=                      # SECRET
NCBI_API_KEY=                    # optional, SECRET
LOG_LEVEL=INFO
