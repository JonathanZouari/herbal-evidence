# --- Backend environment (example; never commit real values) ---
APP_ENV=dev                      # dev | production
PORT=8000                        # Railway injects PORT
SUPABASE_URL=https://<project-ref>.supabase.co          # public
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...            # public
SUPABASE_SECRET_KEY=sb_secret_...                      # SECRET (service role equivalent) - server only; used for Auth admin + herb image storage uploads
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres  # SECRET - session pooler
FRONTEND_ORIGIN=https://<frontend-domain>              # public
CORS_ALLOWED_ORIGINS=https://<frontend-domain>         # comma-separated exact origins
AI_PROVIDER=openai                # openai | none  (no key/model -> jobs fail with ai_not_configured, never mock content)
AI_MODEL=                        # e.g. an OpenAI model id; leave empty until decided
AI_API_KEY=                      # SECRET
AI_TIMEOUT_SECONDS=180
NCBI_API_KEY=                    # optional, SECRET (3 req/s without, 10 req/s with)
NCBI_TOOL=herbal-evidence
NCBI_EMAIL=                      # contact address NCBI asks API users to send
LITERATURE_MAX_RESULTS=20
WIKIMEDIA_CONTACT_EMAIL=                    # contact address Wikimedia asks API users to send
# research worker (runs inside the backend process; keep false while running pytest)
WORKER_ENABLED=false
WORKER_POLL_SECONDS=5
WORKER_LEASE_SECONDS=120
LOG_LEVEL=INFO
# quotas (defaults shown)
MAX_REQUESTS_PER_DAY=5
MAX_OPEN_REQUESTS=3
IP_REQUESTS_PER_MINUTE=120
